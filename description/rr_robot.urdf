<?xml version="1.0"?>
<robot name="rr_robot">
  <link name="base_link"/>

  <link name="link1">
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.04 0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="link2">
    <collision>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.04 0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="tool0"/>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="0" velocity="1.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="0" velocity="1.0"/>
  </joint>

  <joint name="link2-tool0" type="fixed">
    <parent link="link2"/>
    <child link="tool0"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
  </joint>
</robot>
