[submodule "deps/eigen"]
	path = deps/eigen
	url = https://gitlab.com/libeigen/eigen.git
[submodule "deps/json"]
	path = deps/json
	url = https://github.com/nlohmann/json.git
[submodule "deps/toppra"]
	path = deps/toppra/toppra
	url = git@github.com:hungpham2511/toppra.git
[submodule ".ci"]
	path = .ci
	url = https://github.com/epics-base/ci-scripts
[submodule "deps/ompl/ompl"]
	path = deps/ompl/ompl
	url = https://github.com/ompl/ompl.git
[submodule "deps/pinocchio/tinyxml2"]
	path = deps/pinocchio/tinyxml2
	url = https://github.com/leethomason/tinyxml2.git
[submodule "deps/pinocchio/console_bridge"]
	path = deps/pinocchio/console_bridge
	url = https://github.com/ros/console_bridge.git
[submodule "deps/pinocchio/urdfdom_headers"]
	path = deps/pinocchio/urdfdom_headers
	url = https://github.com/ros/urdfdom_headers.git
[submodule "deps/pinocchio/urdfdom"]
	path = deps/pinocchio/urdfdom
	url = https://github.com/ros/urdfdom.git
[submodule "deps/pinocchio/pinocchio"]
	path = deps/pinocchio/pinocchio
	url = https://github.com/stack-of-tasks/pinocchio.git
